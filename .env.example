# Local Oracle VPS configuration
NODE_ENV=production
PORT=3000

# qBittorrent runs beside Torrent Studio in Docker.
QBT_URL=http://qbittorrent:8080
QBT_USERNAME=admin
QBT_PASSWORD=CHANGE_ME
# Optional with qBittorrent 5.2+: QBT_API_KEY=qbt_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Torrent search provider (Prowlarr)
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=CHANGE_ME


# Application login protection
APP_USERNAME=admin
APP_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Public HTTPS hostname for Caddy.
# Create an A record for this hostname pointing to the Oracle VPS public IP.
DOMAIN=seedflow.example.com
